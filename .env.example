# Sovereign Brain API (Node.js/TypeScript)
PORT=8001
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL + pgvector on :5434, owned by Python/Alembic)
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5434/sovereign_brain

# Ollama local inference (supports both OLLAMA_BASE_URL and OLLAMA_URL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERAL_MODEL=qwen3:8b
OLLAMA_CODING_MODEL=qwen3:8b
OLLAMA_PLANNER_MODEL=hermes3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Security (shared secret between frontend app and brain). No default: with no key set,
# protected routes refuse every request. API_KEYS (comma-separated) and BRAIN_API_KEY
# are also accepted, exactly as in the Python backend.
API_KEY=changeme

# Search Cutoffs (cosine distance threshold for nomic-embed-text)
KNOWLEDGE_SEARCH_MAX_DISTANCE=0.5
MEMORY_SEARCH_MAX_DISTANCE=0.5

# CORS Allowed Origins (comma-separated list for production; localhost trusted in dev)
CORS_ALLOWED_ORIGINS=http://localhost:3008,http://127.0.0.1:3008,http://localhost:3000,http://127.0.0.1:3000
